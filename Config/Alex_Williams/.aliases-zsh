function agw_windowserver_fix_if_its_a_bluetooth_crashloop {
    echo "[:FYI:] You should manually run this command:"
    echo "[:OK:]  sudo killall coreaudiod audioaccessoryd SystemUIServer"
    echo "[:FYI:] This might solve the issue if this is showing up in the logs over and over:	coreaudiod	Audio Accessory XPC Connection Error"
}

function agw_venv_on() {
    # This is just an easy way for us to not have to care if the virtual environment
    # folder is named .venv or venv. Finds a 'bin/activate' file.
    local venv_path
    venv_path=$(find . -maxdepth 3 -type f -path "*/bin/activate" | head -n 1)  # Arbitrarily select the first one if there are multiple.
    if [[ -n "$venv_path" ]]; then
        source "$venv_path"  # Found a <dir>/bin/activate, so `source` it to activate the virtualenv
    else
        echo -e "$ERRTT No 'bin/activate' could be found in any subdirectories."
        return 1 # Failure
    fi
}

